# Copie para .env e preencha. NUNCA versionar o .env (RNF: segredos fora do repositório).

# Aplicação
PORT=3333
NODE_ENV=development

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://orcamarcenaria:senha_local@localhost:5432/orcamarcenaria
# Banco exclusivo e descartável para os testes de integração (não use o banco de desenvolvimento).
DATABASE_URL_TESTE=postgresql://orcamarcenaria_teste:senha_local@localhost:5432/orcamarcenaria_teste

# Sessão / autenticação
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRACAO=8h

# Origem permitida para o front-end em desenvolvimento
CORS_ORIGIN=http://localhost:5173

# Endereço do front-end, usado no link do e-mail de recuperação de senha (RF07, D028).
# Na VPS: https://<seu endereço>.sslip.io
URL_FRONTEND=http://localhost:5173

# E-mail (opcional). Sem estas três, o link de recuperação de senha aparece só no console da API.
# Gmail: use uma "senha de app" (Conta Google > Segurança > Senhas de app), não a senha da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USUARIO=sua.conta@gmail.com
# SMTP_SENHA=senha-de-app-de-16-letras
# EMAIL_REMETENTE=OrçaMarcenaria <sua.conta@gmail.com>
